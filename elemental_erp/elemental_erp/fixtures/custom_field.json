[
 {
  "doctype": "Custom Field",
  "name": "Sales Invoice-elemental_job",
  "dt": "Sales Invoice",
  "fieldname": "elemental_job",
  "label": "Elemental Job",
  "fieldtype": "Link",
  "options": "Job",
  "insert_after": "customer",
  "in_list_view": 1,
  "in_standard_filter": 1,
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-elemental_qr_section",
  "dt": "Employee",
  "fieldname": "elemental_qr_section",
  "label": "Gate QR Code",
  "fieldtype": "Section Break",
  "insert_after": "status",
  "collapsible": 1,
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-employee_qr_value",
  "dt": "Employee",
  "fieldname": "employee_qr_value",
  "label": "Employee QR Value (unique)",
  "fieldtype": "Data",
  "insert_after": "elemental_qr_section",
  "unique": 1,
  "read_only": 1,
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-employee_qr_image",
  "dt": "Employee",
  "fieldname": "employee_qr_image",
  "label": "Employee QR Image",
  "fieldtype": "Attach Image",
  "insert_after": "employee_qr_value",
  "read_only": 1,
  "description": "Auto-generated when the Employee record is created \u2014 scan at the gate to check in/out.",
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Attendance-work_from_home",
  "dt": "Attendance",
  "fieldname": "work_from_home",
  "label": "Work from Home",
  "fieldtype": "Check",
  "insert_after": "status",
  "read_only": 1,
  "description": "Set automatically when attendance is created from a Work from Home Request.",
  "in_list_view": 1,
  "in_standard_filter": 1,
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-employee_category",
  "dt": "Employee",
  "fieldname": "employee_category",
  "label": "Employee Category",
  "fieldtype": "Select",
  "options": "\nStaff\nWorker",
  "default": "",
  "insert_after": "designation",
  "reqd": 0,
  "in_list_view": 1,
  "in_standard_filter": 1,
  "description": "Staff = office/management. Worker = factory floor (triggers OT tracking and Worker Attendance Report).",
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-standard_shift_hours",
  "dt": "Employee",
  "fieldname": "standard_shift_hours",
  "label": "Standard Shift Hours",
  "fieldtype": "Float",
  "default": "8",
  "insert_after": "employee_category",
  "description": "Standard working hours per day for this employee. Hours beyond this are counted as Overtime.",
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Salary Slip-overtime_hours",
  "dt": "Salary Slip",
  "fieldname": "overtime_hours",
  "label": "OT Hours (Govt Capped)",
  "fieldtype": "Float",
  "insert_after": "total_working_days",
  "read_only": 1,
  "description": "Auto-calculated: min(Total OT, 15 hrs). Hours worked beyond 8/day. Sunday/Holiday = all hours.",
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Salary Slip-overtime_rate",
  "dt": "Salary Slip",
  "fieldname": "overtime_rate",
  "label": "OT Hourly Rate",
  "fieldtype": "Currency",
  "insert_after": "overtime_hours",
  "read_only": 1,
  "description": "Auto-calculated: Monthly Salary / Days in Month / 8",
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Salary Slip-overtime_amount",
  "dt": "Salary Slip",
  "fieldname": "overtime_amount",
  "label": "OT Amount (2x Rate)",
  "fieldtype": "Currency",
  "insert_after": "overtime_rate",
  "read_only": 1,
  "description": "Auto-calculated: OT Hours × Hourly Rate × 2 (as per govt norm)",
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-checkin_photo",
  "dt": "Employee Checkin",
  "fieldname": "checkin_photo",
  "label": "Site Photo",
  "fieldtype": "Attach Image",
  "insert_after": "geolocation",
  "description": "Photo taken at check-in/out (self-checkin from mobile)",
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-checkin_address",
  "dt": "Employee Checkin",
  "fieldname": "checkin_address",
  "label": "Site Address / Landmark",
  "fieldtype": "Small Text",
  "insert_after": "checkin_photo",
  "description": "Auto-filled from GPS or entered manually",
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-checkin_source",
  "dt": "Employee Checkin",
  "fieldname": "checkin_source",
  "label": "Check-in Source",
  "fieldtype": "Select",
  "options": "\nGate QR\nSelf (Mobile)\nManual (HR)",
  "insert_after": "checkin_address",
  "default": "Gate QR",
  "description": "How this checkin was recorded",
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-installation_worker",
  "dt": "Employee",
  "fieldname": "installation_worker",
  "label": "Installation Worker",
  "fieldtype": "Check",
  "insert_after": "employee_category",
  "description": "Enable if worker is deployed at installation sites (uses mobile self-checkin)",
  "module": "Elemental ERP"
 }
]
