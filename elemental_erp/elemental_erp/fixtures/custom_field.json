[
 {
  "doctype": "Custom Field",
  "name": "Sales Invoice-elemental_job",
  "dt": "Sales Invoice",
  "fieldname": "elemental_job",
  "label": "Elemental Job",
  "fieldtype": "Link",
  "options": "Job",
  "insert_after": "customer",
  "in_list_view": 1,
  "in_standard_filter": 1,
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-elemental_qr_section",
  "dt": "Employee",
  "fieldname": "elemental_qr_section",
  "label": "Gate QR Code",
  "fieldtype": "Section Break",
  "insert_after": "status",
  "collapsible": 1,
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-employee_qr_value",
  "dt": "Employee",
  "fieldname": "employee_qr_value",
  "label": "Employee QR Value (unique)",
  "fieldtype": "Data",
  "insert_after": "elemental_qr_section",
  "unique": 1,
  "read_only": 1,
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-employee_qr_image",
  "dt": "Employee",
  "fieldname": "employee_qr_image",
  "label": "Employee QR Image",
  "fieldtype": "Attach Image",
  "insert_after": "employee_qr_value",
  "read_only": 1,
  "description": "Auto-generated when the Employee record is created \u2014 scan at the gate to check in/out.",
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Attendance-work_from_home",
  "dt": "Attendance",
  "fieldname": "work_from_home",
  "label": "Work from Home",
  "fieldtype": "Check",
  "insert_after": "status",
  "read_only": 1,
  "description": "Set automatically when attendance is created from a Work from Home Request.",
  "in_list_view": 1,
  "in_standard_filter": 1,
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-employee_category",
  "dt": "Employee",
  "fieldname": "employee_category",
  "label": "Employee Category",
  "fieldtype": "Select",
  "options": "\nStaff\nWorker",
  "default": "",
  "insert_after": "designation",
  "reqd": 0,
  "in_list_view": 1,
  "in_standard_filter": 1,
  "description": "Staff = office/management. Worker = factory floor (triggers OT tracking and Worker Attendance Report).",
  "module": "Elemental ERP"
 },
 {
  "doctype": "Custom Field",
  "name": "Employee-standard_shift_hours",
  "dt": "Employee",
  "fieldname": "standard_shift_hours",
  "label": "Standard Shift Hours",
  "fieldtype": "Float",
  "default": "8",
  "insert_after": "employee_category",
  "description": "Standard working hours per day for this employee. Hours beyond this are counted as Overtime.",
  "module": "Elemental ERP"
 }
]
