{
 "doctype": "Print Format",
 "name": "Employee ID Card Front and Back",
 "doc_type": "Employee",
 "module": "Elemental ERP",
 "print_format_type": "Jinja",
 "standard": "Yes",
 "disabled": 0,
 "html": "<style>\n@page { size: 85.6mm 54mm; margin: 0; }\n.id-card { width:85.6mm; height:54mm; box-sizing:border-box; overflow:hidden; font-family:Arial,sans-serif; color:#172033; background:#fff; border:0.35mm solid #182b49; position:relative; }\n.id-card * { box-sizing:border-box; }\n.id-front { page-break-after:always; }\n.id-head { height:12mm; padding:2.2mm 4mm; color:#fff; background:#17365d; }\n.id-company { font-size:4.4mm; font-weight:700; line-height:1.15; }\n.id-subtitle { font-size:2.3mm; opacity:.9; letter-spacing:.25mm; }\n.id-front-body { height:38mm; padding:3mm 3.5mm; display:flex; gap:3mm; align-items:center; }\n.id-photo { width:19mm; height:24mm; object-fit:cover; border:0.35mm solid #aeb8c6; border-radius:1.5mm; }\n.id-photo-empty { width:19mm; height:24mm; border:0.35mm solid #aeb8c6; display:flex; align-items:center; justify-content:center; font-size:2.3mm; color:#777; text-align:center; }\n.id-info { flex:1; min-width:0; }\n.id-name { font-size:4.4mm; font-weight:700; line-height:1.05; margin-bottom:1.5mm; }\n.id-code { display:inline-block; background:#e9eef5; color:#17365d; padding:1mm 2mm; border-radius:1mm; font-size:3mm; font-weight:700; margin-bottom:1.5mm; }\n.id-line { font-size:2.6mm; line-height:1.45; white-space:normal; }\n.id-qr-wrap { width:24mm; text-align:center; }\n.id-qr { width:23mm; max-height:27mm; object-fit:contain; }\n.id-qr-note { font-size:2mm; font-weight:700; color:#17365d; margin-top:.5mm; }\n.id-foot { position:absolute; left:0; right:0; bottom:0; height:4mm; color:#fff; background:#e07a18; font-size:2.2mm; line-height:4mm; text-align:center; letter-spacing:.2mm; }\n.id-back { padding:4mm; }\n.id-back-title { color:#17365d; font-size:4mm; font-weight:700; padding-bottom:1.5mm; border-bottom:.4mm solid #e07a18; }\n.id-back-grid { display:grid; grid-template-columns:24mm 1fr; gap:1.2mm 2mm; margin-top:2.5mm; font-size:2.55mm; line-height:1.3; }\n.id-label { color:#667085; font-weight:700; }\n.id-value { font-weight:600; overflow-wrap:anywhere; }\n.id-address { max-height:11mm; overflow:hidden; }\n.id-terms { position:absolute; left:4mm; right:4mm; bottom:6mm; padding-top:1.5mm; border-top:.25mm solid #c7cfda; font-size:2.05mm; color:#525f70; line-height:1.3; }\n.id-sign { position:absolute; right:5mm; bottom:12mm; width:24mm; border-top:.25mm solid #555; text-align:center; padding-top:1mm; font-size:2mm; }\n@media screen { .id-card { margin:5mm auto; box-shadow:0 1mm 3mm rgba(0,0,0,.18); } }\n@media print { .print-format { margin:0 !important; padding:0 !important; } .id-card { margin:0; box-shadow:none; } }\n</style>\n{% set employee_address = doc.get('current_address') or doc.get('permanent_address') or 'Not provided' %}\n<div class=\"id-card id-front\">\n  <div class=\"id-head\"><div class=\"id-company\">{{ doc.company or 'ELEMENTAL FIXTURES PVT LTD' }}</div><div class=\"id-subtitle\">EMPLOYEE IDENTITY CARD</div></div>\n  <div class=\"id-front-body\">\n    <div>{% if doc.image %}<img class=\"id-photo\" src=\"{{ doc.image }}\">{% else %}<div class=\"id-photo-empty\">EMPLOYEE<br>PHOTO</div>{% endif %}</div>\n    <div class=\"id-info\"><div class=\"id-name\">{{ doc.employee_name }}</div><div class=\"id-code\">{{ doc.name }}</div><div class=\"id-line\"><b>{{ doc.designation or 'Employee' }}</b></div><div class=\"id-line\">{{ doc.department or '' }}</div><div class=\"id-line\"><b>Blood Group:</b> {{ doc.blood_group or '—' }}</div></div>\n    <div class=\"id-qr-wrap\">{% if doc.employee_qr_image %}<img class=\"id-qr\" src=\"{{ doc.employee_qr_image }}\"><div class=\"id-qr-note\">SCAN FOR GATE ENTRY</div>{% else %}<div class=\"id-line\"><b>QR pending</b><br>Save Employee first</div>{% endif %}</div>\n  </div>\n  <div class=\"id-foot\">THIS CARD IS THE PROPERTY OF {{ (doc.company or 'ELEMENTAL FIXTURES')|upper }}</div>\n</div>\n<div class=\"id-card id-back\">\n  <div class=\"id-back-title\">EMPLOYEE DETAILS</div>\n  <div class=\"id-back-grid\">\n    <div class=\"id-label\">Employee Code</div><div class=\"id-value\">{{ doc.name }}</div>\n    <div class=\"id-label\">Blood Group</div><div class=\"id-value\">{{ doc.blood_group or '—' }}</div>\n    <div class=\"id-label\">Mobile</div><div class=\"id-value\">{{ doc.cell_number or doc.personal_mobile or 'Not provided' }}</div>\n    <div class=\"id-label\">Emergency Contact</div><div class=\"id-value\">{{ doc.emergency_phone_number or 'Not provided' }}</div>\n    <div class=\"id-label\">Date of Joining</div><div class=\"id-value\">{{ frappe.utils.formatdate(doc.date_of_joining) if doc.date_of_joining else '—' }}</div>\n    <div class=\"id-label\">Address</div><div class=\"id-value id-address\">{{ employee_address }}</div>\n  </div>\n  <div class=\"id-sign\">Authorised Signatory</div>\n  <div class=\"id-terms\"><b>If found, please return to {{ doc.company or 'Elemental Fixtures Pvt Ltd' }}.</b><br>This card is non-transferable. Loss must be reported immediately to HR.</div>\n  <div class=\"id-foot\">{{ doc.company_email or '' }}{% if doc.company_email and doc.company %} • {% endif %}{{ doc.company or '' }}</div>\n</div>"
}
