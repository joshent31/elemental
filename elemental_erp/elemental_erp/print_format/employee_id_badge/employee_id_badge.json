{
 "doctype": "Print Format",
 "name": "Employee ID Badge",
 "doc_type": "Employee",
 "module": "Elemental ERP",
 "print_format_type": "Jinja",
 "standard": "Yes",
 "disabled": 0,
 "html": "<div style=\"width:100%; padding:10px; font-family:Arial,sans-serif; text-align:center; border:1px solid #ccc;\">\n  <h3 style=\"margin-bottom:2px;\">Elemental Fixtures</h3>\n  <p style=\"color:#666; margin-top:0; font-size:11px;\">Employee ID Badge</p>\n  <hr>\n  <p style=\"font-size:16px; font-weight:bold; margin:6px 0;\">{{ doc.employee_name }}</p>\n  <p style=\"font-size:11px; color:#666; margin:2px 0;\">{{ doc.designation or '' }}</p>\n  <p style=\"font-size:11px; color:#666; margin:2px 0;\">{{ doc.department or '' }}</p>\n  {% if doc.employee_qr_image %}\n    <img src=\"{{ doc.employee_qr_image }}\" style=\"width:140px; height:140px; margin-top:8px;\">\n  {% endif %}\n  <p style=\"font-size:13px; font-weight:bold; margin:4px 0;\">Employee Code: {{ doc.name }}</p>\n  <p style=\"font-size:10px; color:#999; margin-top:6px;\">Scan at the gate to check in / out</p>\n</div>"
}
