{
 "doctype": "Print Format",
 "name": "Packing Box Label",
 "doc_type": "Packing Box",
 "module": "Elemental ERP",
 "print_format_type": "Jinja",
 "standard": "Yes",
 "disabled": 0,
 "html": "<style>\n  .box-label { width:100%; padding:10px; font-family:Arial,sans-serif; text-align:center; border:2px solid #111; color:#111; }\n  .box-label .job-no { font-size:24px; font-weight:bold; padding:6px; border-bottom:2px solid #111; }\n  .box-label .company { font-size:18px; font-weight:bold; margin:8px 0 2px; }\n  .box-label .details { width:100%; border-collapse:collapse; margin:8px 0; text-align:left; font-size:13px; }\n  .box-label .details td { border:1px solid #555; padding:6px; vertical-align:top; }\n  .box-label .label-no { font-size:30px; font-weight:bold; margin:10px 0 4px; }\n  .box-label .qr { width:210px; height:210px; object-fit:contain; }\n  @media print { .box-label { page-break-inside:avoid; } }\n</style>\n{% set job = frappe.get_doc('Job', doc.job) %}\n<div class=\"box-label\">\n  <div class=\"job-no\">JOB NO: {{ doc.job }}</div>\n  <div class=\"company\">ELEMENTAL FIXTURES PVT LTD</div>\n  <table class=\"details\">\n    <tr><td><b>Job Location</b><br>{{ job.job_location or '-' }}</td><td><b>Customer</b><br>{{ job.customer or '-' }}</td></tr>\n    <tr><td colspan=\"2\"><b>Description</b><br>{{ job.job_description or job.job_name or '-' }}</td></tr>\n  </table>\n  <div class=\"label-no\">LABEL {{ doc.box_no }} OF {{ doc.total_boxes }}</div>\n  {% if doc.box_qr_image %}\n    <img src=\"{{ doc.box_qr_image }}\" class=\"qr\">\n  {% else %}\n    <div style=\"padding:50px; border:1px solid #999;\">QR IMAGE NOT GENERATED</div>\n  {% endif %}\n  <div style=\"font-size:11px; font-weight:bold; margin-top:4px;\">{{ doc.box_qr_value or '' }}</div>\n  <p style=\"font-size:11px; color:#555; margin:8px 0 0;\">Scan during packing, dispatch loading, site receipt, and installation.</p>\n</div>"
}
