{
 "doctype": "DocType",
 "name": "FG Subpart",
 "module": "Elemental ERP",
 "custom": 0,
 "istable": 1,
 "editable_grid": 1,
 "engine": "InnoDB",
 "fields": [
  {"fieldname": "part_code", "label": "Part Code", "fieldtype": "Data", "reqd": 1, "read_only": 1, "in_list_view": 1, "columns": 2,
   "description": "Generated automatically as PART-00001 when the Finished Good is saved."},
  {"fieldname": "subpart_name", "label": "Subpart / Description", "fieldtype": "Data", "reqd": 1, "in_list_view": 1, "columns": 3},
  {"fieldname": "ref_image", "label": "Ref Image", "fieldtype": "Attach Image"},
  {"fieldname": "qty_per_fg", "label": "Qty per FG", "fieldtype": "Float", "default": "1", "in_list_view": 1, "columns": 1},
  {"fieldname": "uom", "label": "UOM", "fieldtype": "Link", "options": "UOM", "default": "Nos", "in_list_view": 1, "columns": 1},
  {"fieldname": "process_flow", "label": "Process Flow", "fieldtype": "Data", "read_only": 1,
   "in_list_view": 1, "columns": 3,
   "description": "Automatically shows only the process checkboxes selected below, in production order."},
  {"fieldname": "section_break_processes", "label": "Select Process Flow", "fieldtype": "Section Break"},
  {"fieldname": "process_metal", "label": "Metal", "fieldtype": "Check", "default": "0"},
  {"fieldname": "process_wood", "label": "Wood", "fieldtype": "Check", "default": "0"},
  {"fieldname": "process_electrical", "label": "Electrical", "fieldtype": "Check", "default": "0"},
  {"fieldname": "process_powdercoating", "label": "Powdercoating", "fieldtype": "Check", "default": "0"},
  {"fieldname": "column_break_processes", "fieldtype": "Column Break"},
  {"fieldname": "process_paint", "label": "Paint", "fieldtype": "Check", "default": "0"},
  {"fieldname": "process_us_assembly", "label": "US Assembly", "fieldtype": "Check", "default": "0"},
  {"fieldname": "process_packing", "label": "Packing", "fieldtype": "Check", "default": "0"},
  {"fieldname": "processes", "label": "Legacy Process Storage", "fieldtype": "Small Text", "hidden": 1,
   "description": "Compatibility storage populated automatically from the selected process checkboxes."},
  {"fieldname": "part_qr_value", "label": "Legacy Part QR Value", "fieldtype": "Data", "read_only": 1,
   "description": "Job-specific physical QRs are generated in Job Subpart Label so one Finished Good master can be reused safely across Jobs."}
 ]
}
