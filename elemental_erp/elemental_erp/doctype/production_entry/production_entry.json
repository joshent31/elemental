   "submit": 1,
   "report": 1
  },
  {
   "role": "Elemental Production User",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "report": 1,
   "print": 1
  },
  {
   "role": "Elemental Production HOD",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "delete": 1,
   "report": 1,
   "print": 1,
   "export": 1,
   "email": 1
  },
  {
   "role": "Elemental QC User",
   "read": 1,
   "report": 1
  },
  {
   "role": "Elemental QC HOD",
   "read": 1,
   "report": 1,
   "print": 1
  }
