{
 "doctype": "DocType",
 "name": "Production Entry",
 "module": "Elemental ERP",
 "custom": 0,
 "autoname": "naming_series:",
 "is_submittable": 1,
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "naming_series",
   "label": "Series",
   "fieldtype": "Select",
   "options": "PRD-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "job",
   "label": "Job",
   "fieldtype": "Link",
   "options": "Job",
   "reqd": 1,
   "in_list_view": 1,
   "columns": 2
  },
  {
   "fieldname": "qr_code_master",
   "label": "QR Code (Part x Process)",
   "fieldtype": "Link",
   "options": "QR Code Master",
   "reqd": 1,
   "in_list_view": 1,
   "columns": 2
  },
  {
   "fieldname": "process_name",
   "label": "Process",
   "fieldtype": "Data",
   "fetch_from": "qr_code_master.process_name",
   "read_only": 1,
   "in_list_view": 1,
   "columns": 1
  },
  {
   "fieldname": "column_break_pe1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "produced_qty",
   "label": "Produced Qty",
   "fieldtype": "Float",
   "reqd": 1,
   "in_list_view": 1,
   "columns": 1
  },
  {
   "fieldname": "employee",
   "label": "Employee",
   "fieldtype": "Link",
   "options": "Employee",
   "in_list_view": 1,
   "columns": 2
  },
  {
   "fieldname": "hours_spent",
   "label": "Hours Spent",
   "fieldtype": "Float",
   "description": "Used to compute employee cost against this Job in the Job Consumption Report"
  },
  {
   "fieldname": "production_cost",
   "label": "Cost (est.)",
   "fieldtype": "Currency",
   "read_only": 1
  },
  {
   "fieldname": "production_date",
   "label": "Production Date",
   "fieldtype": "Date",
   "default": "Today",
   "in_list_view": 1,
   "columns": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "report": 1
  },
  {
