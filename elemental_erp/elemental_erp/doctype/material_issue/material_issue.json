{
 "doctype": "DocType",
 "name": "Material Issue",
 "module": "Elemental ERP",
 "custom": 0,
 "autoname": "naming_series:",
 "is_submittable": 1,
 "engine": "InnoDB",
 "editable_grid": 1,
 "fields": [
  {
   "fieldname": "naming_series",
   "label": "Series",
   "fieldtype": "Select",
   "options": "MISS-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "job",
   "label": "Job",
   "fieldtype": "Link",
   "options": "Job",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "columns": 2
  },
  {
   "fieldname": "department",
   "label": "Production Department",
   "fieldtype": "Link",
   "options": "Department",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "columns": 2,
   "description": "e.g. Wood, Metal, Electrical \u2014 whichever department is drawing material for this Job"
  },
  {
   "fieldname": "material_indent",
   "label": "Against Material Indent",
   "fieldtype": "Link",
   "options": "Material Indent"
  },
  {
   "fieldname": "column_break_mi1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "issue_date",
   "label": "Issue Date",
   "fieldtype": "Date",
   "default": "Today",
   "in_list_view": 1,
   "columns": 1
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Issued\nConsumed\nReturned",
   "default": "Issued",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "columns": 2,
   "description": "Issued = lying with the department (WIP), not yet booked as consumed. Flips to Consumed only when the whole Job's material is consumed together."
  },
  {
   "fieldname": "section_break_miitems",
   "label": "Items Issued",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "items",
   "label": "Items",
   "fieldtype": "Table",
   "options": "Material Issue Item",
   "reqd": 1
  }
 ],
